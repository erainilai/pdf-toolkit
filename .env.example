# Copy to .env for local overrides (server.js reads process.env directly — use
# `node --env-file=.env server.js`, or export these before running).

PORT=4321

# Where the local SQLite DB (api keys, jobs, usage) and local-disk file storage live.
# Ignored when S3_BUCKET is set (storage only; the DB is always local SQLite).
DATA_DIR=./data

# Leave unset for single-process "inline" mode (jobs run in the web process, no infra
# needed). Set this to enable the BullMQ job queue + horizontally-scalable workers.
# REDIS_URL=redis://localhost:6379

# Leave unset to store job inputs/outputs on local disk under DATA_DIR/storage. Set to
# use S3 instead — required once you're running more than one web/worker host, since a
# local disk isn't shared across machines. Uses the default AWS credential chain.
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1

# Per-API-key limits on /api/v1/*.
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000

# Worker process concurrency (node src/worker.js / npm run worker). Only relevant when
# REDIS_URL is set.
WORKER_CONCURRENCY=2

# Stripe metered billing for /api/v1/*. Leave STRIPE_SECRET_KEY unset to run with billing
# fully disabled (every key behaves as unmetered — this is the default, nothing breaks).
# See README "Billing (Stripe)" for the one-time setup (create a Meter + metered Price).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...                 # from `stripe listen` or your webhook endpoint config
# STRIPE_METERED_PRICE_ID=price_...               # the metered Price created against your Meter
# STRIPE_METER_EVENT_NAME=pdf_toolkit_jobs         # must match the Meter's "event name" in Stripe
# STRIPE_METER_UNIT=jobs                           # "jobs" (1 per completed job) or "bytes_out"
# APP_URL=http://localhost:4321                    # base URL for Checkout success/cancel redirects

# Uploads and limits.
MAX_UPLOAD_MB=100
# Per-IP limit for the browser UI routes (/api/*), requests per minute. 0 disables (local use).
WEB_RATE_LIMIT_MAX=30
WEB_RATE_LIMIT_WINDOW_MS=60000
# Set to 1 when running behind a reverse proxy / load balancer so limits see real client IPs.
TRUST_PROXY=0
# Job outputs (hosted API) are deleted after this many minutes. Inputs are deleted as soon as
# a job finishes. 0 keeps files forever (not recommended for a public service).
FILE_RETENTION_MINUTES=60

# Tool-specific settings.
OCR_MAX_PAGES=50
OFFICE_TIMEOUT_MS=120000
MAX_THUMBNAIL_PAGES=300
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# BG_MODEL_PATH=./models/u2netp.onnx

# ---------------------------------------------------------------------------
# Commercial web app
# ---------------------------------------------------------------------------
# Brand shown in the UI, checkout and legal pages. Change these, nothing else.
BRAND_NAME=PDF Toolkit
# BRAND_TAGLINE=Every document tool you need, in one place
# SUPPORT_EMAIL=support@yourdomain.in
# LEGAL_NAME=Your Company Pvt Ltd
# LEGAL_ADDRESS=12, Street, City, Tamil Nadu 600001
# BUSINESS_GSTIN=33XXXXXXXXXXXXX
# Public URL (used for Stripe redirects). Required behind a proxy that rewrites Host.
# APP_URL=https://yourdomain.in

# Database. Unset = SQLite file in DATA_DIR (single host). Set for multiple hosts:
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true

# Payments — India (INR) via Razorpay: dashboard → Account & Settings → API keys.
# Webhook URL: https://yourdomain.in/api/webhooks/razorpay  events: order.paid, payment.captured, payment.failed
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# Payments — international (USD) via Stripe uses STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET above.
# Webhook URL: https://yourdomain.in/api/v1/stripe/webhook  events: checkout.session.completed,
# checkout.session.async_payment_succeeded (plus the subscription events for API billing).

# Transactional email (password reset) via Resend: resend.com → API Keys.
# Without this set, reset requests just log the email to the server console instead of sending.
# RESEND_API_KEY=re_...
# EMAIL_FROM=PDF Toolkit <onboarding@resend.dev>   # swap for a verified sending domain in production

# Prices in minor units (paise / cents).
# PRICE_DAYPASS_INR=4900
# PRICE_DAYPASS_USD=299
# PRICE_PRO_MONTHLY_INR=19900
# PRICE_PRO_MONTHLY_USD=699
# PRICE_PRO_YEARLY_INR=149900
# PRICE_PRO_YEARLY_USD=4999

# Plan limits (tasks per day, MB per file, files per task).
# LIMIT_ANON_TASKS=10
# LIMIT_FREE_TASKS=20
# LIMIT_PAID_TASKS=500
# LIMIT_ANON_FILE_MB=20
# LIMIT_FREE_FILE_MB=25
# LIMIT_PAID_FILE_MB=100
# Daily limits reset at midnight in this timezone.
# QUOTA_TIMEZONE=Asia/Kolkata

# Visitor country header from your CDN, used to pre-select ₹ or $ on the pricing page.
# COUNTRY_HEADER=cf-ipcountry

# Sessions / security
# SESSION_TTL_DAYS=30
# COOKIE_SECURE=true          # automatic when NODE_ENV=production
# ALLOWED_ORIGINS=            # extra origins allowed to POST (comma-separated)
# CSP=off                     # disable the Content-Security-Policy header while debugging

# Job processing
# INLINE_CONCURRENCY=4        # without Redis: quick tools in parallel per web process
# INLINE_HEAVY_CONCURRENCY=1  # without Redis: OCR/Office/background removal in parallel
# WORKER_QUEUES=standard,heavy
# WORKER_HEAVY_CONCURRENCY=1
