# Copy to .env for local overrides (server.js reads process.env directly — use
# `node --env-file=.env server.js`, or export these before running).

PORT=4321

# Where the local SQLite DB (api keys, jobs, usage) and local-disk file storage live.
# Ignored when S3_BUCKET is set (storage only; the DB is always local SQLite).
DATA_DIR=./data

# Leave unset for single-process "inline" mode (jobs run in the web process, no infra
# needed). Set this to enable the BullMQ job queue + horizontally-scalable workers.
# REDIS_URL=redis://localhost:6379

# Leave unset to store job inputs/outputs on local disk under DATA_DIR/storage. Set to
# use S3 instead — required once you're running more than one web/worker host, since a
# local disk isn't shared across machines. Uses the default AWS credential chain.
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1

# Per-API-key limits on /api/v1/*.
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000

# Worker process concurrency (node src/worker.js / npm run worker). Only relevant when
# REDIS_URL is set.
WORKER_CONCURRENCY=2

# Stripe metered billing for /api/v1/*. Leave STRIPE_SECRET_KEY unset to run with billing
# fully disabled (every key behaves as unmetered — this is the default, nothing breaks).
# See README "Billing (Stripe)" for the one-time setup (create a Meter + metered Price).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...                 # from `stripe listen` or your webhook endpoint config
# STRIPE_METERED_PRICE_ID=price_...               # the metered Price created against your Meter
# STRIPE_METER_EVENT_NAME=pdf_toolkit_jobs         # must match the Meter's "event name" in Stripe
# STRIPE_METER_UNIT=jobs                           # "jobs" (1 per completed job) or "bytes_out"
# APP_URL=http://localhost:4321                    # base URL for Checkout success/cancel redirects

# Uploads and limits.
MAX_UPLOAD_MB=100
# Per-IP limit for the browser UI routes (/api/*), requests per minute. 0 disables (local use).
WEB_RATE_LIMIT_MAX=30
WEB_RATE_LIMIT_WINDOW_MS=60000
# Set to 1 when running behind a reverse proxy / load balancer so limits see real client IPs.
TRUST_PROXY=0
# Job outputs (hosted API) are deleted after this many minutes. Inputs are deleted as soon as
# a job finishes. 0 keeps files forever (not recommended for a public service).
FILE_RETENTION_MINUTES=60

# Tool-specific settings.
OCR_MAX_PAGES=50
OFFICE_TIMEOUT_MS=120000
MAX_THUMBNAIL_PAGES=300
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# BG_MODEL_PATH=./models/u2netp.onnx
