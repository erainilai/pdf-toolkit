{
  "name": "pdf-toolkit",
  "version": "1.0.0",
  "description": "Self-hostable document toolkit: PDF tools, Office↔PDF, Tamil OCR and font conversion, exam photo resizer, background removal, GST invoices and spreadsheet tools — with a hosted job API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker": "node src/worker.js",
    "keys": "node scripts/manage-keys.mjs",
    "users": "node scripts/manage-users.mjs",
    "models": "node scripts/download-models.mjs",
    "postinstall": "node scripts/download-models.mjs || echo \"Background-removal model not downloaded; run npm run models\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@napi-rs/canvas": "^1.0.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tam": "^1.0.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.34.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "heic-convert": "^2.1.0",
    "multer": "^2.0.0",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pdfjs-dist": "^6.3.289",
    "rate-limit-redis": "^4.2.0",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "onnxruntime-node@1.30.0": true,
    "tesseract.js@7.0.0": true
  }
}
