{
  "name": "pdf-toolkit",
  "version": "1.0.0",
  "description": "Locally runnable PDF toolkit (merge, split, compress, convert, watermark, protect, etc.) - an iLovePDF-style app you run yourself",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker": "node src/worker.js",
    "keys": "node scripts/manage-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@napi-rs/canvas": "^1.0.10",
    "archiver": "^7.0.1",
    "bullmq": "^5.34.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0"
  }
}
